{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "{{VERSION}}",
  "description": "__MSG_description__",
  "default_locale": "en",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "minimum_chrome_version": "111",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["{{TELEMETRY_URL}}/*"],
  "background": { "service_worker": "background.js" },
  "commands": { "add-lecture-moment": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "__MSG_addMoment__" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_popup": "popup.html", "default_title": "__MSG_name__", "default_icon": { "16": "icon-16.png", "32": "icon-32.png" } },
  "content_scripts": [
    { "matches": "{{MATCHES}}", "js": ["shared.js", "bridge.js"], "run_at": "document_start", "world": "ISOLATED", "all_frames": true },
    { "matches": "{{MATCHES}}", "js": ["player.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true }
  ],
  "web_accessible_resources": [{ "resources": ["lib/*", "store.html"], "matches": "{{SITES}}" }]
}
