{
  "name": "lite-player-telemetry-admin",
  "private": true,
  "description": "Read-only dashboard over the anonymous usage data of Lite Player for Echo360 (Cloudflare Worker behind Cloudflare Access).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "assets": "node build-assets.mjs",
    "test": "node build-assets.mjs && node --test --test-concurrency=1 --test-timeout=60000 test/*.test.mjs",
    "dev": "node build-assets.mjs && node dev/serve.mjs",
    "deploy": "node build-assets.mjs && wrangler deploy",
    "lint": "node build-assets.mjs --bundle && eslint .",
    "ci": "npm run lint && npm test"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "wrangler": "4.146.0"
  }
}
